generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  name            String?
  emailVerified   Boolean   @default(false) @map("email_verified")
  isLocked        Boolean   @default(false) @map("is_locked")
  isShadowLocked  Boolean   @default(false) @map("is_shadow_locked")
  isShadowBanned  Boolean   @default(false) @map("is_shadow_banned")
  adminNote       String?   @map("admin_note")
  verifyToken     String?   @map("verify_token")
  resetToken      String?   @map("reset_token")
  resetTokenExp   DateTime? @map("reset_token_exp")
  stripeCustomerId String?  @map("stripe_customer_id")
  planId          String    @default("free") @map("plan_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  apiKeys            UserApiKey[]
  payments           Payment[]
  auditLogs          AuditLog[]         @relation("AuditLogTargetUser")
  billingAdjustments BillingAdjustment[]
  supportTickets     SupportTicket[]
  plan               Plan               @relation(fields: [planId], references: [id])
  accounts           Account[]
  sessions           Session[]

  @@map("users")
}

model Plan {
  id                  String  @id
  name                String
  priceCents          Int     @default(0) @map("price_cents")
  requestsPerDay      Int     @default(100) @map("requests_per_day")
  requestsPerMinute   Int     @default(5) @map("requests_per_minute")
  requestsPerMonth    Int     @default(0) @map("requests_per_month")
  limit5hTokens       Int     @default(1500000) @map("limit_5h_tokens")
  limitWeekTokens     Int     @default(5000000) @map("limit_week_tokens")
  limitMonthTokens    Int     @default(15000000) @map("limit_month_tokens")
  allowedModels       String  @default("*") @map("allowed_models")
  stripePriceId       String? @map("stripe_price_id")
  featured            Boolean @default(false)
  sortOrder           Int     @default(0) @map("sort_order")

  users User[]

  @@map("plans")
}

model UserApiKey {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  omnirouteKeyId  String   @map("omniroute_key_id")
  name            String   @default("Default Key")
  lastFour        String?  @map("last_four")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_api_keys")
}

model Payment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  stripePaymentId String?  @map("stripe_payment_id")
  amountCents     Int      @map("amount_cents")
  planId          String?  @map("plan_id")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model BillingAdjustment {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  amountCents Int      @map("amount_cents")
  reason      String
  status      String   @default("applied")
  actor       String   @default("admin")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("billing_adjustments")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  subject     String
  description String
  status      String   @default("open")
  priority    String   @default("normal")
  assignedTo  String?  @map("assigned_to")
  internalNotes String? @map("internal_notes")
  source      String   @default("manual")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
  @@map("support_tickets")
}

model ScheduledReport {
  id            String   @id @default(uuid())
  name          String
  reportType    String   @map("report_type")
  recipientEmail String  @map("recipient_email")
  cadence       String
  enabled       Boolean  @default(true)
  filters       Json?
  notes         String?
  lastRunAt     DateTime? @map("last_run_at")
  nextRunAt     DateTime? @map("next_run_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([enabled, nextRunAt])
  @@index([reportType, enabled])
  @@map("scheduled_reports")
}

model AdminSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("admin_settings")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  actor         String   @default("admin")
  targetUserId  String?  @map("target_user_id")
  targetUserEmail String? @map("target_user_email")
  metadata      Json?
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  targetUser User? @relation("AuditLogTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
  @@map("audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
