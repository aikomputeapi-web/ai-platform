# AI Platform — Environment Template
# Copy to .env or let setup.sh generate it automatically.

DOMAIN=aiapi.indevs.in
PUBLIC_URL=https://aiapi.indevs.in
SSL_ENABLED=true

# PostgreSQL
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aiplatform

# Redis
REDIS_PASSWORD=CHANGE_ME

# OmniRoute
OMNIROUTE_JWT_SECRET=CHANGE_ME
OMNIROUTE_API_KEY_SECRET=CHANGE_ME
OMNIROUTE_INITIAL_PASSWORD=CHANGE_ME
OMNIROUTE_STORAGE_ENCRYPTION_KEY=CHANGE_ME
OMNIROUTE_DASHBOARD_PORT=20128
OMNIROUTE_API_PORT=20129

# Stripe Payment Integration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: For client-side Stripe.js (if needed in future)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Customer Portal & Authentication
DATABASE_URL=postgresql://aiplatform:CHANGE_ME@postgres:5432/aiplatform
ADMIN_API_SECRET=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME
NEXT_PUBLIC_APP_NAME=AI API Platform
PORTAL_JWT_SECRET=CHANGE_ME

# Stripe Price IDs (set these if using Stripe billing)
# STRIPE_PRICE_ID_PRO=price_your_pro_plan_id
# STRIPE_PRICE_ID_MAX_5X=price_your_max_5x_id
# STRIPE_PRICE_ID_MAX_20X=price_your_max_20x_id
# STRIPE_PRICE_ID_PAYG=price_your_payg_id

# Email (Resend)
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=noreply@yourdomain.com

# Artificial Analysis API key (for model benchmarks)
# AA_API_KEY=your_aa_api_key

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Integration (optional)
# GITHUB_CLIENT_ID=your_github_client_id_here
# GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Apple OAuth Integration (optional)
# APPLE_CLIENT_ID=your_apple_client_id_here
# APPLE_CLIENT_SECRET=your_apple_client_secret_here

# Redis connection string (used by OmniRoute for sessions, rate limits, pools)
# REDIS_URL=redis://:password@redis:6379

# OmniRoute public URL (for OAuth callbacks and admin dashboard)
# OMNIROUTE_PUBLIC_URL=https://admin.yourdomain.com
