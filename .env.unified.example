# AI Platform — Environment Template
# Copy to .env or let setup.sh generate it automatically.

DOMAIN=aiapi.indevs.in
PUBLIC_URL=https://aiapi.indevs.in
SSL_ENABLED=true

# PostgreSQL
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aiplatform

# Redis
REDIS_PASSWORD=CHANGE_ME

# OmniRoute
OMNIROUTE_JWT_SECRET=CHANGE_ME
OMNIROUTE_API_KEY_SECRET=CHANGE_ME
OMNIROUTE_INITIAL_PASSWORD=CHANGE_ME
OMNIROUTE_STORAGE_ENCRYPTION_KEY=CHANGE_ME
OMNIROUTE_DASHBOARD_PORT=20128
OMNIROUTE_API_PORT=20129

# Stripe Payment Integration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: For client-side Stripe.js (if needed in future)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Customer Portal & Authentication
DATABASE_URL=postgresql://aiplatform:PASSWORD@postgres:5432/aiplatform
ADMIN_API_SECRET=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
